# Copy this file to .env (it is gitignored) and fill it in, then `go run .`.
# These are secrets, so DCMS reads them from the environment, never from config.yaml.

# The first admin, created on first start.
DCMS_ADMIN_EMAIL=you@shop.test
DCMS_ADMIN_PASSWORD=shoppass

# HMAC signing secret for the order webhook (see config.yaml → events.webhooks).
DCMS_WEBHOOK_ORDER_SECRET=devsecret
